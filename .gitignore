# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/

# Data, weights and run outputs never go to GitHub
data/*
!data/.gitkeep
models/*
!models/.gitkeep
outputs/
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.bin
*.mp4
*.avi
*.mkv

# Editors / OS
.vscode/
.idea/
.DS_Store

# Ultralytics defaults (only used if it runs without the project-local config in models/ultralytics)
weights/
runs/

# Reference checkouts of official code (used by tests, never committed)
third_party/

# Local camera configs (real camera addresses; credentials belong in environment variables)
configs/*.local.yaml
configs/local/

# Dashboard (Milestone 7): dependencies are installed with npm ci from package-lock.json
node_modules/
